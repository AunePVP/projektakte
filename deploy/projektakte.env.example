# Copy to projektakte.env, fill in, restrict access:  chmod 600 projektakte.env
# Never commit the filled-in file. Values without quotes.

# random, at least 32 characters:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# own address (links in API answers, accepted origin for form submissions)
PUBLIC_URL=https://projektakte.firma.lan

# AI services in the office network
LLM_URL=http://192.168.178.62:8000/v1
EMBED_URL=http://192.168.178.62:8001
RERANK_URL=http://192.168.178.62:4343/rerank
# A question runs up to 4 searches (embedding + reranker each), then the language model.
# ASK_DEADLINE caps a whole question (default 180 s, at least 10 s, 0 = off): no AI call runs past it,
# and without time left the found passages come back. Keep LLM_TIMEOUT below it (start-up warning
# otherwise). It must stay below the proxy timeout (Caddyfile:
# response_header_timeout 240s) and below the 300 s after which Firefox gives up by itself; the app's
# start-up line states the value ("längste Frage"). Raise the proxy timeout too when raising it.
ASK_DEADLINE=180
LLM_TIMEOUT=120
# EMBED_TIMEOUT=30
# RERANK_TIMEOUT=10
# RERANK_FORMAT=tei

# optional: plMail (JMAP) and its integration API
# PLMAIL_URL=https://mail.firma.lan
# PLMAIL_TOKEN=plmail_…
# INTEGRATION_TOKEN=

# COOKIE_SECURE is on in production by default; only switch it off without TLS (not recommended)
# COOKIE_SECURE=0

# PDF, Word, OpenDocument and mail files are read in a separate process with limits per file (memory, CPU time;
# waiting for the vision model does not count). A file over a limit is recorded, not retried.
# EXTRACT_MEMORY_MB=2048
# EXTRACT_CPU_SECONDS=120

# Project folders: names start with the project number. "python -m projektakte.structure" shows your
# scheme and prints these two lines. "auto" = Projektakte proposes the scheme, but reads nothing until
# a person confirms it on the status page (Projektordner → Übernehmen).
PROJECT_NUMBER_PATTERN=auto
# PROJECT_FOLDER_DEPTH=2
# Sites (Bauvorhaben) above the orders: the digits of a site number (orders 101500, 101501 … in the site
# folder 1015_<name> → 4). The orders become Unterprojekte of their site; questions on the site cover them
# all, files in the site folder outside the orders belong to the site. 0 = off (default).
# PROJECT_PARENT_DIGITS=4

# Bildauswertung (LLM_VISION=1): the model reads the scan pages in the background, beside the documents pass,
# pinned projects and the folder order first, newest first inside. Model calls at a time (the AI server takes
# 4; 3 leaves one for questions; 1 = one after the other) and the length of one round in seconds (then the
# next round starts at once and also takes failed pages whose wait is over; 0 = until nothing is pending).
# VISION_CONCURRENCY=3
# VISION_PASS_SECONDS=1800
# Repetition loops: every page answer is streamed and watched; a loop ends the call at once and the page is asked
# once more with these request fields (JSON; default: sampling as recommended for Qwen models against endless
# repetitions). Loops again: the answer is dropped, the page keeps its Tesseract/OCR text. {} = same settings.
# VISION_RETRY_BODY={"temperature": 0.7, "top_p": 0.8, "top_k": 20, "presence_penalty": 1.5}
# Embeddings in the background, beside the documents pass: batches sent to the embedding service at a time (1–8).
# EMBED_CONCURRENCY=2
# Document types: ask the language model about documents whose type stays unclear – auto (real AI services
# only, never the fake), 1 (always), 0 (never). One call at a time, never while a question runs.
# DOKUMENTART_KI=auto

# Photos in these folders are not sent to the vision model (comma-separated; "Bilder" also matches
# 263900-Bilder). Remove the line later to have them read.
# VISION_SKIP_FOLDERS=Bilder

# Top-level folders under PROJECTS_DIR whose projects are read first, in this order (comma-separated; the
# other folders follow). Only a default: once the order is changed on the status page ("Reihenfolge der
# Ordner"), the stored one applies.
# INDEX_FOLDER_ORDER=3,2

# Only these top-level folders under PROJECTS_DIR are searched for projects (comma-separated; empty = all).
# PROJECTS_TOP_FOLDERS=1,2,3,4,5,6,7,8,9

# Tesseract off (scan pages without a text layer are read by the vision model only):
# TESSERACT=0
