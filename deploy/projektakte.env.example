# Copy to projektakte.env, fill in, restrict access:  chmod 600 projektakte.env
# Never commit the filled-in file. Values without quotes.

# random, at least 32 characters:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# own address (links in API answers, accepted origin for form submissions)
PUBLIC_URL=https://projektakte.firma.lan

# AI services in the office network
LLM_URL=http://192.168.178.62:8000/v1
EMBED_URL=http://192.168.178.62:8001
RERANK_URL=http://192.168.178.62:4343/rerank
# must stay below the proxy timeout (Caddyfile: response_header_timeout 180s)
LLM_TIMEOUT=120

# optional: plMail (JMAP) and its integration API
# PLMAIL_URL=https://mail.firma.lan
# PLMAIL_TOKEN=plmail_…
# INTEGRATION_TOKEN=

# COOKIE_SECURE is on in production by default; only switch it off without TLS (not recommended)
# COOKIE_SECURE=0
